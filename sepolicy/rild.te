allow rild libqmi_oem_main:unix_stream_socket connectto;

# rild is somehow trying to execute /system/bin/ip
# we don't allow it and we don't want it logged all the time
dontaudit rild system_file:file execute_no_trans;

# Another one - but this time no clue what it wants to execute
dontaudit rild shell_exec:file execute;

# rild executes /system/bin/sh for legacy qcom data scripts
allow rild shell_exec:file { read open getattr execute execute_no_trans };

# The IRadio 1.4 wrapper (android.hardware.radio@1.4-service.legacy, hal_radio_default) calls
# rild's IRadio 1.1 and rild calls back into it; both are hal_telephony servers (kiwi's
# 2026-10-20 enforcing harvest found nothing else the wrapper needs).
binder_call(hal_radio_default, rild)
binder_call(rild, hal_radio_default)
