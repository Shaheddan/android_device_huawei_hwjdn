allow hal_light_default libqmi_oem_main:unix_stream_socket connectto;

# The light HAL writes /sys/class/leds/lcd-backlight/brightness (labelled
# sysfs_graphics). Without this it exits with EACCES, ILight never registers,
# hwservicemanager retries it as a lazy HAL forever, and system_server's
# LightsService blocks -> bootloop.
allow hal_light_default sysfs_graphics:file rw_file_perms;
allow hal_light_default sysfs_graphics:dir search;
# The HAL reaches the node via /sys/class/leds/... — those parent dirs and the
# symlink are plain sysfs, so the sysfs_graphics rule alone isn't enough.
allow hal_light_default sysfs:dir search;
allow hal_light_default sysfs:lnk_file read;
