# Lights
/sys/devices/soc\.0/gpio-leds\.[a-z0-9]+/leds(/.*)?        u:object_r:sysfs_leds:s0

# Oem Info
/dev/oinv(/.*)?                                            u:object_r:oeminfo_device:s0
/dev/socket/oeminfo_nvm                                    u:object_r:oeminfo_socket:s0
/system/vendor/bin/huawei_version                          u:object_r:oeminfo_exec:s0
/system/vendor/bin/oeminfo_nvm_server                      u:object_r:oeminfo_exec:s0
/system/vendor/bin/rmt_oeminfo                             u:object_r:oeminfo_exec:s0

# fsc is mmcblk0p15 on this device (kiwi's p18 is our persist)
/dev/block/platform/soc.0/7824900.sdhci/mmcblk0p15         u:object_r:fsc_block_device:s0
/dev/block/platform/soc.0/7824900.sdhci/mmcblk0p9          u:object_r:oem_block_device:s0
/dev/bluetooth                                             u:object_r:bluetooth_device:s0
/dev/rfkill                                                u:object_r:rfkill_device:s0

/sys/bus/platform/drivers/hw_audio_info(/.*)?              u:object_r:hw_audio_info_sysfs:s0
/system/vendor/bin/libqmi_oem_main                         u:object_r:libqmi_oem_main_exec:s0
/system/vendor/bin/teecd                                   u:object_r:tee_exec:s0

/dev/stune(/.*)?                                           u:object_r:cgroup:s0

# HALs
/system/vendor/bin/hw/android\.hardware\.light@2\.0-service\.hwjdn                       u:object_r:hal_light_default_exec:s0

# Same-process HALs: gralloc is loaded into coredomain processes (bootanim, apps). As
# vendor_file, bootanim could not even stat it on kiwi's Android 14, libhardware fell back to
# gralloc.default and every buffer from the allocator was an "invalid gralloc handle".
/(vendor|system/vendor)/lib(64)?/hw/gralloc\.msm8916\.so    u:object_r:same_process_hal_file:s0
/(vendor|system/vendor)/lib(64)?/libmemalloc\.so            u:object_r:same_process_hal_file:s0

# AIDL Power HAL, software Gatekeeper, and PowerStats mock (18.1 services;
# labels absent from platform and sepolicy-legacy — added per Motorola msm8916 18.1 pattern)
/(vendor|system/vendor)/bin/hw/android\.hardware\.gatekeeper@1\.0-service\.software    u:object_r:hal_gatekeeper_default_exec:s0
/(vendor|system/vendor)/bin/hw/android\.hardware\.power\.stats@1\.0-service\.mock      u:object_r:hal_power_stats_default_exec:s0
/(vendor|system/vendor)/bin/hw/android\.hardware\.drm@1\.4-service\.clearkey    u:object_r:hal_drm_default_exec:s0

# Sensors HAL (hal_sensors_default.te): the input directories of the BMA255 accelerometer
# (0-0018, the same bus and address as kiwi's lis3dh) and of the AP3426 light/proximity sensor
# (0-001e), and the virtual input directories kiwi's blob reads. Input numbers can change,
# so regex. The exact files will come from the first boot's harvest.
/sys/devices/soc\.0/78b6000\.i2c/i2c-0/0-0018/input/input[0-9]+                u:object_r:sysfs_sensors:s0
/sys/devices/soc\.0/78b6000\.i2c/i2c-0/0-001e/input/input[0-9]+                u:object_r:sysfs_sensors:s0
/sys/devices/virtual/input/input[0-9]+                                         u:object_r:sysfs_sensors:s0
/data/misc/akmd_set\.txt                                                         u:object_r:sensors_data_file:s0

# Bypass charging node. sepolicy-legacy's .../power_supply/battery(/.*)? entry relabels it
# sysfs_battery_supply when ueventd restorecons /sys, overriding the genfscon label; an exact
# path is more specific, so this wins (kiwi lineage-21 ddd330a).
/sys/devices/soc\.0/78b8000\.i2c/i2c-4/4-006b/power_supply/battery/factory_diag  u:object_r:sysfs_bypass_charging:s0
