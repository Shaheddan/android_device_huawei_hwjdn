# Android 14 runs the sensors HAL as android.hardware.sensors@1.0-service (hal_sensors_default)
# instead of passthrough inside system_server, where 19.1 and 20 gave Huawei's sensors.hwjdn.so
# system_server's rights. From kiwi's harvest of its own Huawei sensors blob (the same family):
#  - /proc/app_info (board and sensor part information) and Huawei's oeminfo_nvm socket;
#  - /data/misc/akmd_set.txt, the AKM compass calibration (path built into the blob; harmless
#    here, where no compass answers on the bus), labelled sensors_data_file;
#  - the sensors' input directories, labelled sysfs_sensors in file_contexts;
#    sepolicy-legacy's hal_sensors.te already allows rw on sysfs_sensors and reads input_device.
allow hal_sensors_default proc_app_info:file r_file_perms;
unix_socket_connect(hal_sensors_default, oeminfo, oeminfo)
allow hal_sensors_default sensors_data_file:file { rw_file_perms setattr };

# The tablet's own harvest (2026-11-07, one boot with rotation, auto-brightness and the
# light sensor in use, the domain still permissive): no sysfs denials - the sensor input
# dirs are already sysfs_sensors - and only liboeminfo's replies. Like system_server,
# bluetooth_loader and wcnss_service, the HAL reads each reply file the oeminfo daemon
# leaves in /dev/oinv (<epoch>.<pid>) and deletes it. The domain is enforcing now.
allow hal_sensors_default oeminfo_device:dir { search write remove_name };
allow hal_sensors_default oeminfo_device:file { getattr open read unlink };
