# AIDL service registration: servicemanager inspects the registrant
allow servicemanager hal_power_default:dir search;
allow servicemanager hal_power_default:file { read open };
allow servicemanager hal_power_default:process getattr;

# jdn: core_ctl screen-on: park / unpark CPU cores through core_ctl on
# screen off / on (power/power-interactive-ext.c).
r_dir_file(hal_power_default, sysfs_devices_system_cpu)
allow hal_power_default sysfs_devices_system_cpu:file w_file_perms;
