<?xml version="1.0" encoding="UTF-8"?>
<!--
  hwjdn device, kernel and vendor for LineageOS 22.2.

  WHY only the three hwjdn repos here: hwjdn builds against kiwi's trees, and
  in a tree that also builds kiwi, kiwi's own manifests already declare them.
  repo refuses a project declared twice, so:
    next to kiwi's kiwi.xml and kiwi-support.xml: this file alone;
    in a tree without kiwi: this file plus hwjdn-kiwi.xml and hwjdn-support.xml.

  WHY declared here rather than hand-copied: an unmanaged directory is pruned
  by ANY repo sync, even one scoped to a single project. That destroyed
  device/qcom/sepolicy-legacy and its local commits during the 19.1 port.

  - kernel at kernel/huawei/jdn, not .../hwjdn: BoardConfig.mk's
    TARGET_KERNEL_SOURCE names that path.
  - All three track lineage-22.2, branched 2026-11-12 off the finished
    LineageOS 21 heads (device ee5d3fc, kernel 0a70d0c, vendor 4139dd6).
    The lineage-21 branches stay as the fallback.
-->
<manifest>

  <remote name="shaheddan"
          fetch="https://github.com/Shaheddan" />

  <project path="device/huawei/hwjdn"
           name="android_device_huawei_hwjdn"
           remote="shaheddan" revision="lineage-22.2" />

  <project path="kernel/huawei/jdn"
           name="android_kernel_huawei_hwjdn"
           remote="shaheddan" revision="lineage-22.2" />

  <project path="vendor/huawei/hwjdn"
           name="proprietary_vendor_huawei_hwjdn"
           remote="shaheddan" revision="lineage-22.2" />

</manifest>
