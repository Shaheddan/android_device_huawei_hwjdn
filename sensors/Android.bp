cc_library_static {
    name: "multihal-hwjdn",
    vendor: true,
    // Android 14: vendor modules no longer get libhardware on the global include path.
    header_libs: ["libhardware_headers"],
    srcs: [
        "multihal.cpp",
        "SensorEventQueue.cpp"
    ],
    shared_libs: [
        "liblog",
        "libcutils",
        "libutils",
        "libdl"
    ],
    export_include_dirs: ["."],
}
