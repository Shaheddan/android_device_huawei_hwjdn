<?xml version="1.0" encoding="utf-8"?>
<!-- Charging optimization, Android 15 layout: intro, the animated status card, the main
     switch, then the two modes as radio rows sharing one card (the limit slider appears
     under "Limit to" when that mode is in use), and a footer. The page writes the same
     keys as before (bypass_now, bypass_auto, bypass_threshold), so BypassService reads
     them unchanged. -->
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <com.android.settingslib.widget.TopIntroPreference
        android:key="bypass_intro"
        android:title="@string/bypass_intro" />

    <org.lineageos.settings.jdn.BypassStatusPreference
        android:key="bypass_status" />

    <org.lineageos.settings.jdn.BypassMainSwitchPreference
        android:key="bypass_main"
        android:title="@string/bypass_main_title" />

    <org.lineageos.settings.jdn.BypassModePreference
        android:key="bypass_mode_limit"
        android:title="@string/bypass_limit_title"
        android:summary="@string/bypass_limit_summary" />

    <org.lineageos.settings.jdn.BypassLevelPreference
        android:key="bypass_threshold"
        android:title="@string/bypass_threshold_title"
        android:max="100"
        app:min="10"
        android:defaultValue="80"
        app:showSeekBarValue="false"
        app:updatesContinuously="true" />

    <org.lineageos.settings.jdn.BypassModePreference
        android:key="bypass_mode_hold"
        android:title="@string/bypass_hold_title"
        android:summary="@string/bypass_hold_summary" />

    <com.android.settingslib.widget.FooterPreference
        android:key="footer_preference"
        android:title="@string/bypass_footer"
        android:selectable="false" />

</PreferenceScreen>
