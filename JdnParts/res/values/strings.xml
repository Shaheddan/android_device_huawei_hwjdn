    <!-- Battery health tips card -->
    <string name="tips_title">Battery health tips</string>
    <string name="tip_heat_title">Keep it cool</string>
    <string name="tip_heat_body">Heat wears a battery fastest. Use and charge the tablet between 0 and 35 °C, and avoid charging it somewhere hot, like a car in the sun or under a pillow.</string>
    <string name="tip_full_title">Don\'t keep it full</string>
    <string name="tip_full_body">Hours at full charge age the battery. Charging optimization can hold it at a lower level while the tablet stays plugged in.</string>
    <string name="tip_storage_title">Store it half charged</string>
    <string name="tip_storage_body">If you won\'t use the tablet for weeks, leave the battery about half charged and turn the tablet off. Top it up every few months so it never drains completely.</string>
    <string name="tip_drain_title">Use less power every day</string>
    <string name="tip_drain_body">Lower brightness, a shorter screen timeout and Battery Saver mean fewer charge cycles, which slows wear. Try not to run the battery all the way down.</string>

