    <!-- ==== Charging optimization page (bypass charging) ==== -->
    <string name="bypass_intro">Run the tablet straight from the charger instead of charging the battery, so it isn\'t kept at a high charge while plugged in.</string>
    <string name="bypass_main_title">Use bypass charging</string>
    <string name="bypass_limit_title">Limit to %1$d%%</string>
    <string name="bypass_limit_summary">Charge normally up to the limit, then run the tablet from the charger</string>
    <string name="bypass_hold_title">Hold current level</string>
    <string name="bypass_hold_summary">Stop charging now and run the tablet from the charger</string>
    <string name="bypass_threshold_title">Charging limit</string>
    <string name="bypass_threshold_summary">Charge up to %1$d%%, then hold</string>
    <string name="bypass_footer">While bypass is active, the charger powers the tablet and the battery stays at its level, which reduces heat and battery wear. Normal charging always returns when you unplug the charger.</string>
