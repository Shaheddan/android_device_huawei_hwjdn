<?xml version="1.0" encoding="utf-8"?>
<!-- Battery health status at the top of the page: the animated circle and its label, with
     a line of advice when the status is Reduced or not set up. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingTop="8dp"
    android:paddingBottom="20dp">

    <org.lineageos.settings.jdn.HealthBadgeView
        android:id="@+id/health_badge_view"
        android:layout_width="120dp"
        android:layout_height="120dp" />

    <TextView
        android:id="@+id/health_badge_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif"
        android:textSize="26sp" />

    <TextView
        android:id="@+id/health_badge_detail"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:paddingStart="40dp"
        android:paddingEnd="40dp"
        android:gravity="center"
        android:textSize="14sp"
        android:visibility="gone" />
</LinearLayout>
