<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.lineageos.settings.jdn"
    android:sharedUserId="android.uid.system">
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>
    <application
        android:label="@string/jdn_parts_title"
        android:persistent="true"
        android:theme="@style/Theme.SubSettingsBase">

        <!-- Settings > Battery > Battery health. The summary under it (Normal / Reduced /
             Not set up) comes live from HealthSummaryProvider; there is deliberately no
             static summary, because Settings only asks the provider when none is set. -->
        <activity
            android:name=".BatteryHealthActivity"
            android:label="@string/health_title"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
            </intent-filter>
            <intent-filter>
                <action android:name="com.android.settings.action.IA_SETTINGS"/>
            </intent-filter>
            <meta-data android:name="com.android.settings.category"
                android:value="com.android.settings.category.ia.battery"/>
            <meta-data android:name="com.android.settings.summary_uri"
                android:value="content://org.lineageos.settings.jdn.health/getSummary/battery_health"/>
        </activity>

        <!-- Bypass charging, now "Charging optimization" inside Battery health. -->
        <activity
            android:name=".BypassChargingActivity"
            android:label="@string/optimization_title"
            android:exported="false"/>

        <provider
            android:name=".HealthSummaryProvider"
            android:authorities="org.lineageos.settings.jdn.health"
            android:exported="true"/>

        <receiver android:name=".BootReceiver" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED"/>
            </intent-filter>
        </receiver>
        <service android:name=".BypassService"/>
    </application>
</manifest>
