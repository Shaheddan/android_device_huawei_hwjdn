From ddd44b8f9f22a1f87191d787f76d3c688b0bbae3 Mon Sep 17 00:00:00 2001
From: shahed <jamshidalinezhadian@gmail.com>
Date: Thu, 8 Oct 2026 22:13:22 +0330
Subject: [PATCH 4/6] display: request libhardware/media headers for Android 14

Android 14 builds every vendor module VNDK-style, without the old global include dirs, so libqdMetaData failed on <hardware/gralloc.h>. gl_headers was already added; this adds libhardware_headers and media_plugin_headers to every display module.

Change-Id: I163d39944c9b732ad823dc16374cca6be7f0f247
---
 libgralloc/Android.mk    | 6 ++++++
 libhdmi/Android.mk       | 3 +++
 libhwcomposer/Android.mk | 3 +++
 liblight/Android.mk      | 3 +++
 libmemtrack/Android.mk   | 3 +++
 liboverlay/Android.mk    | 3 +++
 libqdutils/Android.mk    | 9 +++++++++
 libqservice/Android.mk   | 3 +++
 8 files changed, 33 insertions(+)

diff --git a/libgralloc/Android.mk b/libgralloc/Android.mk
index 055d32c..8b4f51b 100644
--- a/libgralloc/Android.mk
+++ b/libgralloc/Android.mk
@@ -27,6 +27,9 @@ LOCAL_CFLAGS                  := $(common_flags) -DLOG_TAG=\"qdgralloc\"
 LOCAL_HEADER_LIBRARIES        := generated_kernel_headers display_headers gl_headers
 LOCAL_SRC_FILES               := gpu.cpp gralloc.cpp framebuffer.cpp mapper.cpp
 
+# kiwi: Android 14 builds every vendor module VNDK-style, without the old global
+# include dirs; request libhardware and media plugin/OMX headers explicitly.
+LOCAL_HEADER_LIBRARIES += libhardware_headers media_plugin_headers
 include $(BUILD_SHARED_LIBRARY)
 
 # MemAlloc Library
@@ -44,4 +47,7 @@ ifeq ($(TARGET_USE_COMPAT_GRALLOC_ALIGN),true)
 LOCAL_CFLAGS += -DDISABLE_GET_PIXEL_ALIGNMENT
 endif
 
+# kiwi: Android 14 builds every vendor module VNDK-style, without the old global
+# include dirs; request libhardware and media plugin/OMX headers explicitly.
+LOCAL_HEADER_LIBRARIES += libhardware_headers media_plugin_headers
 include $(BUILD_SHARED_LIBRARY)
