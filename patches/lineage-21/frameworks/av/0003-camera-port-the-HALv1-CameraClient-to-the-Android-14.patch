From a2bd74d474c47a04cae65c6b073fb09532bd994b Mon Sep 17 00:00:00 2001
From: shahed <jamshidalinezhadian@gmail.com>
Date: Wed, 7 Oct 2026 18:20:37 +0330
Subject: [PATCH 3/4] camera: port the HALv1 CameraClient to the Android 14
 client interface

std: :string constructor/initialize/injectCamera, setRotateAndCropOverride(fromHal), the new setAutoframingOverride/supportsZoomOverride/setZoomOverride/injectSessionParams (unsupported on HALv1), and logClose through CameraService's CameraServiceProxyWrapper instance.
Change-Id: I96182209c3bbcab75fd35bd60a8837546c0a1a3f
---
 .../libcameraservice/api1/CameraClient.cpp    | 34 +++++++++++++++----
 .../libcameraservice/api1/CameraClient.h      | 15 +++++---
 2 files changed, 38 insertions(+), 11 deletions(-)

diff --git a/services/camera/libcameraservice/api1/CameraClient.cpp b/services/camera/libcameraservice/api1/CameraClient.cpp
index a926cfe..92ad0cd 100644
--- a/services/camera/libcameraservice/api1/CameraClient.cpp
+++ b/services/camera/libcameraservice/api1/CameraClient.cpp
@@ -35,12 +35,12 @@ namespace android {
 
 CameraClient::CameraClient(const sp<CameraService>& cameraService,
         const sp<hardware::ICameraClient>& cameraClient,
-        const String16& clientPackageName, const std::optional<String16>& clientFeatureId,
+        const std::string& clientPackageName, const std::optional<std::string>& clientFeatureId,
         int cameraId, int cameraFacing, int sensorOrientation,
         int clientPid, int clientUid,
         int servicePid):
         Client(cameraService, cameraClient, clientPackageName, /*systemNativeClient*/ false,
-                clientFeatureId, String8::format("%d", cameraId), cameraId, cameraFacing,
+                clientFeatureId, std::to_string(cameraId), cameraId, cameraFacing,
                 sensorOrientation, clientPid, clientUid, servicePid,
                 /*overrideToPortrait*/ false)
 {
@@ -61,7 +61,7 @@ CameraClient::CameraClient(const sp<CameraService>& cameraService,
 }
 
 status_t CameraClient::initialize(sp<CameraProviderManager> manager,
-        const String8& /*monitorTags*/) {
+        const std::string& /*monitorTags*/) {
     int callingPid = CameraThreadState::getCallingPid();
     status_t res;
 
@@ -283,7 +283,10 @@ binder::Status CameraClient::disconnect() {
 
     LOG1("disconnect X (pid %d)", callingPid);
     int32_t closeLatencyMs = ns2ms(systemTime() - startTime);
-    CameraServiceProxyWrapper::logClose(mCameraIdStr, closeLatencyMs);
+    // Android 14: the proxy wrapper is an instance owned by CameraService. connectHelper()
+    // logs the open for every client, so the HALv1 client must log the close as well.
+    sCameraService->mCameraServiceProxyWrapper->logClose(mCameraIdStr, closeLatencyMs,
+            /*deviceError*/ false);
     return res;
 }
 
@@ -1213,7 +1216,7 @@ int32_t CameraClient::getGlobalAudioRestriction() {
 }
 
 // API1->Device1 does not support this feature
-status_t CameraClient::setRotateAndCropOverride(uint8_t /*rotateAndCrop*/) {
+status_t CameraClient::setRotateAndCropOverride(uint8_t /*rotateAndCrop*/, bool /*fromHal*/) {
     return OK;
 }
 
@@ -1232,7 +1235,7 @@ void CameraClient::setStreamUseCaseOverrides(
 void CameraClient::clearStreamUseCaseOverrides() {
 }
 
-status_t CameraClient::injectCamera(const String8& /*injectedCamId*/,
+status_t CameraClient::injectCamera(const std::string& /*injectedCamId*/,
         sp<CameraProviderManager> /*manager*/) {
     return INVALID_OPERATION;
 }
@@ -1245,4 +1248,23 @@ status_t CameraClient::setCameraMute(bool /*enabled*/) {
     return OK;
 }
 
+// Android 14 additions to CameraService::BasicClient. A HALv1 device has none of
+// these features, so they are reported as unsupported.
+status_t CameraClient::setAutoframingOverride(uint8_t /*autoframingValue*/) {
+    return INVALID_OPERATION;
+}
+
+bool CameraClient::supportsZoomOverride() {
+    return false;
+}
+
+status_t CameraClient::setZoomOverride(int32_t /*zoomOverride*/) {
+    return INVALID_OPERATION;
+}
+
+status_t CameraClient::injectSessionParams(
+        const hardware::camera2::impl::CameraMetadataNative& /*sessionParams*/) {
+    return INVALID_OPERATION;
+}
+
 }; // namespace android
diff --git a/services/camera/libcameraservice/api1/CameraClient.h b/services/camera/libcameraservice/api1/CameraClient.h
index ee69c89..b6c66e4 100644
--- a/services/camera/libcameraservice/api1/CameraClient.h
+++ b/services/camera/libcameraservice/api1/CameraClient.h
@@ -62,7 +62,8 @@ public:
     virtual status_t        setAudioRestriction(int mode);
     virtual int32_t         getGlobalAudioRestriction();
 
-    virtual status_t        setRotateAndCropOverride(uint8_t override);
+    virtual status_t        setRotateAndCropOverride(uint8_t override, bool fromHal = false);
+    virtual status_t        setAutoframingOverride(uint8_t autoframingValue);
 
     virtual bool            supportsCameraMute();
     virtual status_t        setCameraMute(bool enabled);
@@ -72,15 +73,19 @@ public:
     virtual void            setStreamUseCaseOverrides(
                                     const std::vector<int64_t>& useCaseOverrides) override;
     virtual void            clearStreamUseCaseOverrides() override;
-    virtual status_t        injectCamera(const String8& injectedCamId,
+    virtual status_t        injectCamera(const std::string& injectedCamId,
                                     sp<CameraProviderManager> manager) override;
     virtual status_t        stopInjection() override;
+    virtual bool            supportsZoomOverride() override;
+    virtual status_t        setZoomOverride(int32_t zoomOverride) override;
+    virtual status_t        injectSessionParams(
+            const hardware::camera2::impl::CameraMetadataNative& sessionParams) override;
 
     // Interface used by CameraService
     CameraClient(const sp<CameraService>& cameraService,
             const sp<hardware::ICameraClient>& cameraClient,
-            const String16& clientPackageName,
-            const std::optional<String16>& clientFeatureId,
+            const std::string& clientPackageName,
+            const std::optional<std::string>& clientFeatureId,
             int cameraId,
             int cameraFacing,
             int sensorOrientation,
@@ -90,7 +95,7 @@ public:
     ~CameraClient();
 
     virtual status_t initialize(sp<CameraProviderManager> manager,
-            const String8& monitorTags) override;
+            const std::string& monitorTags) override;
 
     virtual status_t dump(int fd, const Vector<String16>& args);
 
-- 
2.43.0

