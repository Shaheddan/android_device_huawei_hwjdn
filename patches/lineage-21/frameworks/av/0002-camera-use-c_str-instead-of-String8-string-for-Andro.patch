From afbb35b1694968c26e178eba7dca14b23b3f092c Mon Sep 17 00:00:00 2001
From: shahed <jamshidalinezhadian@gmail.com>
Date: Mon, 5 Oct 2026 13:49:53 +0330
Subject: [PATCH 2/4] camera: use c_str() instead of String8::string() for
 Android 14

String8: :string() is private in Android 14's libutils; the restored HALv1 code still used it.
Change-Id: I44fc7669392e35cd53edfd08b78911f10154184b
---
 camera/Camera.cpp                             |  2 +-
 .../libcameraservice/CameraFlashlight.cpp     |  8 +--
 .../libcameraservice/api1/CameraClient.cpp    |  4 +-
 .../device1/CameraHardwareInterface.cpp       | 54 +++++++++----------
 4 files changed, 34 insertions(+), 34 deletions(-)

diff --git a/camera/Camera.cpp b/camera/Camera.cpp
index aaca329..4a831ab 100644
--- a/camera/Camera.cpp
+++ b/camera/Camera.cpp
@@ -127,7 +127,7 @@ status_t Camera::connectLegacy(int cameraId, int halVersion,
             default:
                 status = -EINVAL;
                 ALOGW("An error occurred while connecting to camera %d: %s", cameraId,
-                        (cs != nullptr) ? "Service not available" : ret.toString8().string());
+                        (cs != nullptr) ? "Service not available" : ret.toString8().c_str());
                 break;
         }
         c.clear();
diff --git a/services/camera/libcameraservice/CameraFlashlight.cpp b/services/camera/libcameraservice/CameraFlashlight.cpp
index 5012312..093694a 100644
--- a/services/camera/libcameraservice/CameraFlashlight.cpp
+++ b/services/camera/libcameraservice/CameraFlashlight.cpp
@@ -590,12 +590,12 @@ status_t CameraHardwareInterfaceFlashControl::initializePreviewWindow(
 status_t CameraHardwareInterfaceFlashControl::connectCameraDevice(
         const String8& cameraId) {
     sp<CameraHardwareInterface> device =
-            new CameraHardwareInterface(cameraId.string());
+            new CameraHardwareInterface(cameraId.c_str());
 
     status_t res = device->initialize(mProviderManager);
     if (res) {
         ALOGE("%s: initializing camera %s failed", __FUNCTION__,
-                cameraId.string());
+                cameraId.c_str());
         return res;
     }
 
@@ -608,14 +608,14 @@ status_t CameraHardwareInterfaceFlashControl::connectCameraDevice(
     res = getSmallestSurfaceSize(&width, &height);
     if (res) {
         ALOGE("%s: failed to get smallest surface size for camera %s",
-                __FUNCTION__, cameraId.string());
+                __FUNCTION__, cameraId.c_str());
         return res;
     }
 
     res = initializePreviewWindow(device, width, height);
     if (res) {
         ALOGE("%s: failed to initialize preview window for camera %s",
-                __FUNCTION__, cameraId.string());
+                __FUNCTION__, cameraId.c_str());
         return res;
     }
 
diff --git a/services/camera/libcameraservice/api1/CameraClient.cpp b/services/camera/libcameraservice/api1/CameraClient.cpp
