From 3ec4716ff8572447be6daa057a0eddc089126488 Mon Sep 17 00:00:00 2001
From: shahed <jamshidalinezhadian@gmail.com>
Date: Sun, 27 Sep 2026 22:48:59 +0330
Subject: [PATCH] telephony: activate default UICC apps for legacy RILs
 (simactivation)

Port of 'telephony: Squashed support for simactivation feature' to
Android 13: RIL reads ro.telephony.ril.config and UiccProfile activates
the default GSM/CDMA UICC apps once the card is present. Legacy Qualcomm
RILs (kiwi) otherwise never bind the subscription for voice/SMS: dial
and send work, but call state, incoming calls and incoming SMS never
arrive. Keeps Android 13's setUiccSubscription() signature.

Change-Id: I548aa1aebe5598e5eaf3965489f0e94367dd6b18
---
 .../com/android/internal/telephony/RIL.java   | 13 +++++
 .../internal/telephony/uicc/UiccProfile.java  | 57 +++++++++++++++++++
 2 files changed, 70 insertions(+)

diff --git a/src/java/com/android/internal/telephony/RIL.java b/src/java/com/android/internal/telephony/RIL.java
index 70431f6..c3f0a24 100644
--- a/src/java/com/android/internal/telephony/RIL.java
+++ b/src/java/com/android/internal/telephony/RIL.java
@@ -198,6 +198,9 @@ public class RIL extends BaseCommands implements CommandsInterface {
 
     private boolean mUseOldMncMccFormat;
 
+    // Legacy RIL behaviours a device asks for via ro.telephony.ril.config (e.g. "simactivation").
+    private List<String> mOldRilFeatures;
+
     private static final String PROPERTY_IS_VONR_ENABLED = "persist.radio.is_vonr_enabled_";
 
     static final int RADIO_SERVICE = 0;
@@ -1057,6 +1060,9 @@ public class RIL extends BaseCommands implements CommandsInterface {
         mUseOldMncMccFormat = SystemProperties.getBoolean(
                 "ro.telephony.use_old_mnc_mcc_format", false);
 
+        final String oldRilFeatures = SystemProperties.get("ro.telephony.ril.config", "");
+        mOldRilFeatures = Arrays.asList(oldRilFeatures.split(","));
+
         TelephonyManager tm = (TelephonyManager) context.getSystemService(
                 Context.TELEPHONY_SERVICE);
         mIsCellularSupported = tm.isVoiceCapable() || tm.isSmsCapable() || tm.isDataCapable();
@@ -4083,6 +4089,13 @@ public class RIL extends BaseCommands implements CommandsInterface {
         }
     }
 
+    /**
+     * Whether the device requested a legacy RIL behaviour through ro.telephony.ril.config.
+     */
+    public boolean needsOldRilFeature(String feature) {
+        return mOldRilFeatures.contains(feature);
+    }
+
     /**
      * Whether the device modem supports reporting the EID in either the slot or card status or
      * through ATR.
diff --git a/src/java/com/android/internal/telephony/uicc/UiccProfile.java b/src/java/com/android/internal/telephony/uicc/UiccProfile.java
index aca03ca..b86e3cf 100644
--- a/src/java/com/android/internal/telephony/uicc/UiccProfile.java
+++ b/src/java/com/android/internal/telephony/uicc/UiccProfile.java
@@ -61,6 +61,7 @@ import com.android.internal.telephony.MccTable;
 import com.android.internal.telephony.Phone;
 import com.android.internal.telephony.PhoneConstants;
 import com.android.internal.telephony.PhoneFactory;
+import com.android.internal.telephony.RIL;
 import com.android.internal.telephony.SubscriptionController;
 import com.android.internal.telephony.TelephonyStatsLog;
 import com.android.internal.telephony.cat.CatService;
@@ -115,6 +116,7 @@ public class UiccProfile extends IccCard {
     private UiccCarrierPrivilegeRules mCarrierPrivilegeRules;
     private UiccCarrierPrivilegeRules mTestOverrideCarrierPrivilegeRules;
     private boolean mDisposed = false;
+    private boolean mDefaultAppsActivated;
 
     private RegistrantList mOperatorBrandOverrideRegistrants = new RegistrantList();
 
@@ -1127,10 +1129,65 @@ public class UiccProfile extends IccCard {
             if (mRadioTech != ServiceState.RIL_RADIO_TECHNOLOGY_UNKNOWN) {
                 setCurrentAppType(ServiceState.isGsm(mRadioTech));
             }
+
+            // Legacy Qualcomm RILs (pre-M behaviour) only bind the subscription for voice
+            // and SMS once the default UICC apps are activated explicitly; without it
+            // requests work but call state and incoming calls/SMS never reach us.
+            if (needsSimActivation()) {
+                if (ics.mCardState == CardState.CARDSTATE_PRESENT) {
+                    if (!mDefaultAppsActivated) {
+                        activateDefaultApps();
+                        mDefaultAppsActivated = true;
+                    }
+                } else {
+                    // SIM removed: activate again at the next insertion.
+                    mDefaultAppsActivated = false;
+                }
+            }
+
             updateIccAvailability(true);
         }
     }
 
+    private boolean needsSimActivation() {
+        if (mCi instanceof RIL) {
+            return ((RIL) mCi).needsOldRilFeature("simactivation");
+        }
+        return false;
+    }
+
+    private void activateDefaultApps() {
+        int gsmIndex = mGsmUmtsSubscriptionAppIndex;
+        int cdmaIndex = mCdmaSubscriptionAppIndex;
+
+        if (gsmIndex < 0 || cdmaIndex < 0) {
+            for (int i = 0; i < mUiccApplications.length; i++) {
+                if (mUiccApplications[i] == null) {
+                    continue;
+                }
+
+                AppType appType = mUiccApplications[i].getType();
+                if (gsmIndex < 0
+                        && (appType == AppType.APPTYPE_USIM || appType == AppType.APPTYPE_SIM)) {
+                    gsmIndex = i;
+                } else if (cdmaIndex < 0
+                        && (appType == AppType.APPTYPE_CSIM || appType == AppType.APPTYPE_RUIM)) {
+                    cdmaIndex = i;
+                }
+            }
+        }
+        // Same request the legacy patch sent: slot and subscription type = this phone,
+        // activation status 1 (activate).
+        if (gsmIndex >= 0) {
+            log("activateDefaultApps: activating GSM/UMTS app " + gsmIndex);
+            mCi.setUiccSubscription(mPhoneId, gsmIndex, mPhoneId, 1, null);
+        }
+        if (cdmaIndex >= 0) {
+            log("activateDefaultApps: activating CDMA app " + cdmaIndex);
+            mCi.setUiccSubscription(mPhoneId, cdmaIndex, mPhoneId, 1, null);
+        }
+    }
+
     private void createAndUpdateCatServiceLocked() {
         if (mUiccApplications.length > 0 && mUiccApplications[0] != null) {
             // Initialize or Reinitialize CatService
