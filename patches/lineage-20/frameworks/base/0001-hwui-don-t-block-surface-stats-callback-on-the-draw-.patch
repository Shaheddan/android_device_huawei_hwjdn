From 3a65f3044cdc4dae9e2ed09b3cf26978d7946676 Mon Sep 17 00:00:00 2001
From: shahed <jamshidalinezhadian@gmail.com>
Date: Fri, 25 Sep 2026 19:10:02 +0330
Subject: [PATCH 1/2] hwui: don't block surface-stats callback on the draw lock

CanvasContext::draw() holds mFrameMetricsReporterMutex across the whole
render pipeline draw, including dequeueBuffer(). If dequeue has to wait
for a buffer release, that release is delivered to the same
TransactionCompletedListener as the surface-stats callback, which was
blocked on the same mutex: RenderThread and binder thread deadlock
until HWUI's 4 s dequeue timeout. Try the lock and skip this frame's
completion stats instead of waiting.

Change-Id: Ia06a75d7ec4d30e077de26f96568d43c393c590e
---
 libs/hwui/renderthread/CanvasContext.cpp | 11 ++++++++++-
 1 file changed, 10 insertions(+), 1 deletion(-)

diff --git a/libs/hwui/renderthread/CanvasContext.cpp b/libs/hwui/renderthread/CanvasContext.cpp
index f56d19bf..2823341b 100644
--- a/libs/hwui/renderthread/CanvasContext.cpp
+++ b/libs/hwui/renderthread/CanvasContext.cpp
@@ -764,7 +764,16 @@ void CanvasContext::onSurfaceStatsAvailable(void* context, int32_t surfaceContro
     FrameInfo* frameInfo = instance->getFrameInfoFromLast4(frameNumber, surfaceControlId);
 
     if (frameInfo != nullptr) {
-        std::scoped_lock lock(instance->mFrameMetricsReporterMutex);
+        // The RenderThread holds mFrameMetricsReporterMutex for all of draw(), and
+        // draw() can block in dequeueBuffer() waiting for a buffer release that
+        // SurfaceFlinger delivers to this same listener after this callback. Waiting
+        // here deadlocks both until HWUI's 4 s dequeue timeout (seen on kiwi as
+        // 4-second UI freezes); dropping this frame's completion stats costs nothing
+        // on screen.
+        if (!instance->mFrameMetricsReporterMutex.try_lock()) {
+            return;
+        }
+        std::lock_guard lock(instance->mFrameMetricsReporterMutex, std::adopt_lock);
         frameInfo->set(FrameInfoIndex::FrameCompleted) = std::max(gpuCompleteTime,
                 frameInfo->get(FrameInfoIndex::SwapBuffersCompleted));
         frameInfo->set(FrameInfoIndex::GpuCompleted) = std::max(
