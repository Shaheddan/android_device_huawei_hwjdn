@@ -797,6 +806,20 @@ public class CameraDeviceUserShim implements ICameraDeviceUser {
         throw new UnsupportedOperationException("Legacy device does not support offline mode");
     }
 
+    // Android 15 QPR2: camera2 clients read result metadata from an FMQ the camera service
+    // creates. The legacy device delivers its results in the callbacks themselves and has no
+    // queue; CameraDeviceImpl skips the FMQ reader when this returns null.
+    @Override
+    public MQDescriptor<Byte, Byte> getCaptureResultMetadataQueue() {
+        return null;
+    }
+
+    // Shared camera access is a camera2-service feature; the legacy device is never shared.
+    @Override
+    public boolean isPrimaryClient() {
+        return true;
+    }
+
