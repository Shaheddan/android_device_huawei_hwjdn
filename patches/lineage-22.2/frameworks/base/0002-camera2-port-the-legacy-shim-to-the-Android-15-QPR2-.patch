 import android.hardware.camera2.params.StreamConfigurationMap;
 import android.hardware.camera2.utils.SubmitInfo;
 import android.hardware.camera2.utils.SurfaceUtils;
+import android.hardware.common.fmq.MQDescriptor;
 import android.os.Binder;
 import android.os.Build;
 import android.os.Handler;
@@ -486,9 +487,14 @@ public class CameraDeviceImpl extends CameraDevice
             if (mInError) return;
 
             mRemoteDevice = new ICameraDeviceUserWrapper(remoteDevice);
-            Parcel resultParcel = Parcel.obtain();
-            mRemoteDevice.getCaptureResultMetadataQueue().writeToParcel(resultParcel, 0);
-            mFMQReader = nativeCreateFMQReader(resultParcel);
+            // The legacy camera2 shim (HALv1 devices) has no result FMQ: it delivers metadata
+            // inside each result callback, so there is no queue reader to create.
+            MQDescriptor<Byte, Byte> resultQueue = mRemoteDevice.getCaptureResultMetadataQueue();
+            if (resultQueue != null) {
+                Parcel resultParcel = Parcel.obtain();
+                resultQueue.writeToParcel(resultParcel, 0);
+                mFMQReader = nativeCreateFMQReader(resultParcel);
+            }
 
             IBinder remoteDeviceBinder = remoteDevice.asBinder();
             // For legacy camera device, remoteDevice is in the same process, and
