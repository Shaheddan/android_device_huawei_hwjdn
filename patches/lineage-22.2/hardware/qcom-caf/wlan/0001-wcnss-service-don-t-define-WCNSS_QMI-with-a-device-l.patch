From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: shahed <jamshidalinezhadian@gmail.com>
Date: Thu, 5 Nov 2026 10:35:00 +0330
Subject: [PATCH] wcnss-service: don't define WCNSS_QMI with a device
 libwcnss_qmi

Since "Allow using WCNSS QMI without building with BSP", a non-QCPATH
build always adds -DWCNSS_QMI, and TARGET_PROVIDES_WCNSS_QMI adds
-DWCNSS_QMI_OSS on top. WCNSS_QMI makes wcnss_service.c include
wcnss_qmi_client.h, whose prototypes clash with the function pointers
the WCNSS_QMI_OSS path declares for the dlopened library:

  wcnss_service.c:717:14: error: redefinition of 'wcnss_init_qmi' as
  different kind of symbol

Define WCNSS_QMI only for the built-in client, so a device library
gets the WCNSS_QMI_OSS path alone, as before that change.

Change-Id: I5a2d8c7e0b4f9a1d6c3e8b5f2a7d0c9e4b1f6a83
---
 wcnss-service/Android.mk | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/wcnss-service/Android.mk b/wcnss-service/Android.mk
index b77e664..bf0b016 100644
--- a/wcnss-service/Android.mk
+++ b/wcnss-service/Android.mk
@@ -21,11 +21,13 @@ LOCAL_HEADER_LIBRARIES += libmdmdetect_headers
 LOCAL_SHARED_LIBRARIES += libmdmdetect
 LOCAL_HEADER_LIBRARIES += libril-qc-qmi-services-headers
 else
-LOCAL_CFLAGS += -DWCNSS_QMI
 LOCAL_SHARED_LIBRARIES += libdl
 ifeq ($(TARGET_PROVIDES_WCNSS_QMI),true)
+# A device libwcnss_qmi is dlopened through the WCNSS_QMI_OSS function pointers;
+# WCNSS_QMI would also declare those names from wcnss_qmi_client.h and clash.
 LOCAL_CFLAGS += -DWCNSS_QMI_OSS
 else
+LOCAL_CFLAGS += -DWCNSS_QMI
 LOCAL_SRC_FILES += wcnss_qmi_client.c missing_qmi_client_api.c
 LOCAL_CFLAGS += -DWCNSS_QMI_PRIVATE
 endif #TARGET_PROVIDES_WCNSS_QMI
