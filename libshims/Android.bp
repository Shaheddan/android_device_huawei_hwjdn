soong_namespace {
}

cc_library_shared {
    // Renamed for hwjdn: kiwi's copy of this module sits in the root Soong
    // namespace and Make's module table is flat, so two modules named
    // libshim_cutils collide in base_rules.mk whatever Soong does. stem keeps
    // the installed filename libshim_cutils.so, which is what BoardConfig.mk's
    // TARGET_LD_SHIM_LIBS entries key on.
    name: "libshim_cutils_hwjdn",
    srcs: [
        "hw_cutils.c",
        "hw_log.c",
    ],

}
